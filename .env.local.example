# OutfitAI 环境变量示例
# 复制此文件为 .env.local 并填入实际值

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 本地开发站点 URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Qwen / DashScope
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-plus

# Embedding（DashScope OpenAI 兼容 API）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# 天气 API（服务端调用，默认 WeatherAPI.com）
WEATHER_API_KEY=c4489ee61e7144a7a8131628260907
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1

# 应用配置
NEXT_PUBLIC_APP_NAME=OutfitAI

# 移动端 API Gateway（Next.js 服务地址，供 Expo App 调用）
# 本地开发示例：http://localhost:3000
# 真机调试请改为电脑局域网 IP，例如 http://192.168.1.10:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
