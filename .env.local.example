# OutfitAI 环境变量示例
# 复制此文件为 .env.local 并填入实际值
# 切勿将真实 Key 提交到仓库；若示例文件曾泄露过真实 Key，请到对应平台重置。

# Supabase（项目 Settings → API）
# NEXT_PUBLIC_SUPABASE_URL: 项目 URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY: 匿名公钥（可暴露给浏览器，仍受 RLS 约束）
# SUPABASE_SERVICE_ROLE_KEY: 服务端密钥（仅脚本/服务端，禁止写入客户端）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 本地开发站点 URL（Auth 回调等）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Qwen / DashScope（服务端 AI：识别、推荐、embedding）
# QWEN_API_KEY: DashScope API Key
# QWEN_BASE_URL: OpenAI 兼容接口地址
# QWEN_MODEL: 默认视觉/对话模型
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-plus

# Embedding（DashScope OpenAI 兼容 API）
# EMBEDDING_MODEL / EMBEDDING_DIMENSIONS 需与 schema 中 vector 维度一致
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# 天气 API（服务端调用，默认 WeatherAPI.com；可选，缺失时天气推荐自动降级）
WEATHER_API_KEY=your_weather_api_key
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1

# 应用配置
NEXT_PUBLIC_APP_NAME=OutfitAI

# 移动端 API Gateway（Next.js 服务地址，供 Expo App 调用）
# 本地开发示例：http://localhost:3000
# 真机调试请改为电脑局域网 IP，例如 http://192.168.1.10:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
